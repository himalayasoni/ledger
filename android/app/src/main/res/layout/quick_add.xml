<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <LinearLayout
        android:id="@+id/q_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/q_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/q_title"
                android:textColor="@color/q_ink"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/q_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/q_open"
                android:textColor="@color/q_ink2"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/q_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/q_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="₹0"
                android:textColor="@color/q_ink"
                android:textSize="44sp"
                android:textStyle="bold" />
            <GridLayout
                android:id="@+id/q_cats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:columnCount="3" />
            <TextView
                android:id="@+id/q_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="@string/q_hint"
                android:textColor="@color/q_ink2"
                android:textSize="12sp" />
            <GridLayout
                android:id="@+id/q_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/q_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="22dp"
            android:paddingBottom="10dp"
            android:visibility="gone">
            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/q_tick"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/accent_ink"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/q_done_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/q_ink"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/q_undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:text="@string/q_undo"
                android:textColor="@color/q_ink2"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
