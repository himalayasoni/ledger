<?xml version="1.0" encoding="utf-8"?>
<!-- What the small widget looks like in the widget picker (Android 12+). Plain views only, like any widget layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="6dp" android:background="@drawable/wp_surface">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:background="@drawable/wp_accent" android:gravity="center" android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_widget_plus"
            android:tint="@color/wp_accent_ink" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="@string/sc_add_short" android:textColor="@color/wp_accent_ink" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp"
        android:background="@drawable/wp_deep" android:gravity="center" android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_widget_mic"
            android:tint="@color/wp_accent" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="@string/sc_say_short" android:textColor="@color/wp_accent" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
