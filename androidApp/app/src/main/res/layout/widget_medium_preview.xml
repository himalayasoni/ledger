<?xml version="1.0" encoding="utf-8"?>
<!-- What the medium widget looks like in the widget picker (Android 12+), with example numbers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/wp_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SPENT THIS MONTH" android:textColor="@color/wp_ink2" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="₹12,340" android:textColor="@color/wp_ink" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Today ₹240" android:textColor="@color/wp_ink2" android:textSize="12sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/wp_deep">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_widget_mic" android:tint="@color/wp_accent" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="8dp" android:background="@drawable/wp_accent">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_widget_plus" android:tint="@color/wp_accent_ink" android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="10dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:background="@drawable/wp_surface2" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="10dp" android:paddingEnd="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1"
                android:text="Chai" android:textColor="@color/wp_ink" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="₹20" android:textColor="@color/wp_ink2" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/wp_surface2" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="10dp" android:paddingEnd="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1"
                android:text="Uber" android:textColor="@color/wp_ink" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="₹240" android:textColor="@color/wp_ink2" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:background="@drawable/wp_surface2" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="10dp" android:paddingEnd="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1"
                android:text="Groceries" android:textColor="@color/wp_ink" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="₹850" android:textColor="@color/wp_ink2" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/wp_surface2" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="10dp" android:paddingEnd="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1"
                android:text="Auto" android:textColor="@color/wp_ink" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="₹60" android:textColor="@color/wp_ink2" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
